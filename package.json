{
  "name": "nero-agent",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check . && node scripts/check-banned-apis.mjs",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "boundaries": "depcruise apps packages",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries",
    "build": "tsc -b",
    "nero": "tsc -b && node apps/cli/dist/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
